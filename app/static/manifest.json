{
  "name": "Deeperguard",
  "short_name": "Deeperguard",
  "description": "Zero-knowledge encrypted notes",
  "start_url": "/app",
  "display": "standalone",
  "background_color": "#0f1419",
  "theme_color": "#0f1419",
  "orientation": "any",
  "share_target": {
    "action": "/app/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "icons": [
    {
      "src": "/static/icons/icon-192.png?v=__NOTES_BUILD__",
