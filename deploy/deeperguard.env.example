# --- Network ---
# LAN + WireGuard only. For WAN, set NOTES_DISABLE_CIDR_GATE=1 and use HTTPS + a tunnel.
NOTES_ALLOWED_CIDRS=192.168.1.0/24,10.0.0.0/24
# NOTES_DISABLE_CIDR_GATE=0
# NOTES_TRUST_PROXY_HOPS=0

# Pin the HTTPS link on the plain-HTTP certificate setup page (Host-header safe).
# Use a hostname (not an IP) when you want passkeys / WebAuthn on iOS.
NOTES_PUBLIC_HOST=www.deeperguard.com
# WebAuthn RP ID — registrable domain (passkeys work on www + apex when this is the parent zone).
NOTES_WEBAUTHN_RP_ID=deeperguard.com
# Used in time-warning emails. Defaults to https://$NOTES_PUBLIC_HOST
# NOTES_PUBLIC_URL=https://www.deeperguard.com
# Time zone used to render the reminder time in time-warning emails.
# NOTES_EMAIL_TZ=Europe/Amsterdam

# --- Auth & zero-knowledge ---
# 1 = vault passwords never sent to server (recommended). 0 = legacy server verify (debug only).
NOTES_STRICT_ZK=1
# 1 = anyone on the network can register. Set 0 to close sign-ups after launch.
NOTES_ALLOW_REGISTER=1
NOTES_MIN_PASSWORD_LENGTH=12
# 1 = session cookies only over HTTPS (required on WAN).
NOTES_SECURE_COOKIES=0
# 1 = skip the login page (testing only). Default is 0: show the login page.
NOTES_SKIP_LOGIN=0

# Comma-separated admin emails (dashboard at /admin).
NOTES_ADMIN_EMAILS=admin@example.com
# Default encrypted storage quota for new accounts (megabytes). 0 = unlimited.
NOTES_DEFAULT_USER_QUOTA_MB=100
# basic or pro — during public beta use pro so new accounts get Pro features free
NOTES_DEFAULT_PLAN=pro
# Optional one-time: set default quota on existing unlimited accounts (0 = unlimited).
# NOTES_APPLY_DEFAULT_QUOTA_TO_EXISTING=1
# Max quota an admin may assign (megabytes). Default 1 TB.
# NOTES_MAX_USER_QUOTA_MB=1048576
# In-app auth rate limits (tightened automatically when NOTES_DISABLE_CIDR_GATE=1).
# NOTES_AUTH_RATE_LIMIT=24
# NOTES_AUTH_RATE_LIMIT_WAN=12
# NOTES_AUTH_RATE_WINDOW=300
# Also run: bash deploy/setup-cloudflare-rate-limits.sh (edge WAF for /api/auth/*)

NOTES_SMTP_HOST=smtp.example.com
NOTES_SMTP_PORT=587
NOTES_SMTP_FROM=notes@deeperguard.com
NOTES_SMTP_TLS=1
# NOTES_SMTP_USER=
# NOTES_SMTP_TLS=0

# OCR plaintext is not persisted on disk unless you set NOTES_OCR_EPHEMERAL=0 (not recommended).
# NOTES_OCR_EPHEMERAL=1
# Legacy server-side OCR (plaintext on server). Disabled by default — client OCR is zero-knowledge.
# NOTES_SERVER_OCR=0
NOTES_BACKUP_CRON_HOUR=3
# Local full-backup gzip files kept on the server (each can be hundreds of MB).
# NOTES_BACKUP_LOCAL_KEEP=5
# Max bytes per sync pull page (attachment ciphertext adds up fast).
# NOTES_SYNC_PAGE_BYTES=3500000
# Server info cache refresh interval in seconds (default 300).
# NOTES_SERVER_INFO_REFRESH_SEC=300
# Set to 0 to persist OCR plaintext on disk (not recommended).
# NOTES_OCR_EPHEMERAL=1
# Optional standalone OCR worker on 127.0.0.1:8081 (see deeperguard-ocr.service).
# NOTES_OCR_PORT=8081
# pCloud sync uses rclone (installed by deploy/bootstrap.sh). Per-user credentials are set in Settings.
# NOTES_PCLOUD_RETENTION_DAYS=7
# NOTES_PCLOUD_RCLONE_TIMEOUT=3600
