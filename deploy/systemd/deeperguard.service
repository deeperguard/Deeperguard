[Unit]
Description=Deeperguard (zero-knowledge encrypted notes)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/deeperguard/app
Environment=PYTHONPATH=/opt/deeperguard/app
EnvironmentFile=-/opt/deeperguard/config/deeperguard.env
ExecStart=/opt/deeperguard/venv/bin/gunicorn --bind 0.0.0.0:80 --workers 1 --threads 4 --timeout 600 app:app
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
